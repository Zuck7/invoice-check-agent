# Copy to .env and fill in. .env is gitignored — never commit a real key.
#   cp .env.example .env

# --- Vision provider (only needed to read scanned PDFs and images) ---
# Born-digital PDFs and CSVs never touch a model and need none of this.

# Which provider reads scans: gemini (default) or anthropic
INVOICE_AUDIT_VISION=gemini

# Gemini — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Claude — only if INVOICE_AUDIT_VISION=anthropic
# ANTHROPIC_API_KEY=
